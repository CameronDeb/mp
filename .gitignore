# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# Paid Power Tools product files (audio, workbook PDFs). These are the goods
# customers pay for — they must never enter git history, and they are far too
# large for the repo. They belong in private object storage, served through
# time-limited signed download links after a Stripe purchase.
/power-tool-files/

# typescript
*.tsbuildinfo
next-env.d.ts
